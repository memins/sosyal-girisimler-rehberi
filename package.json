{
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others-on-fail --names \"api,web\" --prefix-colors \"yellow,cyan\" \"npm:dev:api\" \"npm:dev:web\"",
		"dev:api": "wrangler dev --port 8787",
		"dev:web": "vite --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"preview": "vite preview --host 0.0.0.0",
		"test": "vitest run",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"worker:types": "wrangler types",
		"worker:dev": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"db:migrate:local": "wrangler d1 execute sosyal-girisimler-rehberi --local --file ./src/db/schema.sql",
		"db:seed:local": "wrangler d1 execute sosyal-girisimler-rehberi --local --file ./src/db/seed.sql",
		"db:migrate:remote": "wrangler d1 execute sosyal-girisimler-rehberi --remote --file ./src/db/schema.sql",
		"db:seed:remote": "wrangler d1 execute sosyal-girisimler-rehberi --remote --file ./src/db/seed.sql"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.8",
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-checkbox": "latest",
		"@radix-ui/react-dialog": "latest",
		"@radix-ui/react-label": "latest",
		"@radix-ui/react-select": "latest",
		"@radix-ui/react-slot": "latest",
		"@radix-ui/react-tabs": "latest",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "latest",
		"class-variance-authority": "latest",
		"clsx": "latest",
		"cmdk": "^1.1.1",
		"lucide-react": "latest",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "latest",
		"react-dom": "latest",
		"react-hook-form": "^7.74.0",
		"react-router-dom": "latest",
		"sonner": "^2.0.7",
		"tailwind-merge": "latest",
		"tailwindcss": "latest",
		"tw-animate-css": "latest",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "latest",
		"@eslint/js": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"concurrently": "^9.2.1",
		"eslint": "latest",
		"eslint-plugin-react-hooks": "latest",
		"eslint-plugin-react-refresh": "latest",
		"globals": "latest",
		"typescript": "latest",
		"typescript-eslint": "latest",
		"vite": "latest",
		"vitest": "latest",
		"wrangler": "latest"
	}
}
